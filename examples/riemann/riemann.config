; -*- mode: clojure; -*-
; Standalone Riemann config for the sqrt(z) monodromy demo:
;
;   riemann examples/riemann/riemann.config
;
; Ingests z-path events on TCP 5555, performs analytic continuation in
; the stream (see continuation.clj), and serves both the raw path and
; the continued root on the websocket query surface at 5556, where the
; dashboard watches them.

(logging/init)

(tcp-server {:host "0.0.0.0" :port 5555})
(ws-server  {:host "0.0.0.0" :port 5556})

(periodically-expire 5)

(include "continuation.clj")

(let [index (index)]
  (streams
    (default :ttl 10
      index
      (where (service "z")
        (riemann.surface-demo/continue-sqrt index)))))
